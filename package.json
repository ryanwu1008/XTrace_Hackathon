{
  "name": "vsee-vc",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --import tsx --test --test-concurrency=1 \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\"",
    "test:migrations": "REQUIRE_POSTGRES_MIGRATION_TESTS=1 node --import tsx --test --test-concurrency=1 tests/integration/report-next-step-migration.test.ts tests/integration/company-analyses-migration.test.ts tests/integration/production-baseline-bridge.test.ts tests/integration/workspace-composite-migration.test.ts tests/integration/schema-migrations.test.ts tests/integration/underwriting-reference-migration.test.ts tests/integration/upload-confirmation-migration.test.ts tests/integration/action-draft-migration.test.ts tests/integration/framework-catalog-checkpoint-migration.test.ts tests/integration/public-sandbox-reset-migration.test.ts tests/integration/pgcrypto-registry-schema-usage-migration.test.ts tests/integration/belief-reversal-evidence-context-migration.test.ts tests/integration/belief-reversal-demo-seed-migration.test.ts tests/integration/xtrace-lineage-v2-migration.test.ts tests/integration/task9-finalization-authority-migration.test.ts tests/integration/pg17-market-event-validator-migration.test.ts tests/integration/research-candidate-xtrace-migration.test.ts tests/integration/underwriting-presentation-migration.test.ts",
    "test:migrations:production-pg176": "REQUIRE_POSTGRES_MIGRATION_TESTS=1 REQUIRE_SUPABASE_PG176_MIGRATION_TESTS=1 node --import tsx --test --test-concurrency=1 --test-name-pattern=\"^(the PostgreSQL 17.6 Supabase superuser profile reaches reviewed 0018 then safely refuses unreviewed 0019|the PostgreSQL 17.6 non-superuser CREATEROLE profile reaches reviewed 0018 then safely refuses unreviewed 0019|the PostgreSQL 17.6 repaired ACL profile reaches reviewed 0018 then safely refuses unreviewed 0019)$\" tests/integration/production-baseline-bridge.test.ts && printf '%s\\n' 'SAFE_REFUSAL — production forward migration remains blocked'",
    "test:e2e:belief-reversal": "REQUIRE_BELIEF_REVERSAL_E2E=1 REQUIRE_POSTGRES_MIGRATION_TESTS=1 node --import tsx --test --test-concurrency=1 tests/integration/belief-reversal-demo-e2e.test.ts",
    "demo:belief-reversal:browser": "node --import tsx scripts/run-belief-reversal-browser-fixture.ts",
    "test:legacy": "npm run build && node --test tests/rendered-html.test.mjs",
    "verify:web-parser-boundary": "node scripts/verify-web-parser-boundary.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "worker": "tsx worker/runner.ts",
    "xtrace:ingest": "tsx worker/run-exact-xtrace-ingest.ts",
    "worker:health": "node --import tsx worker/health.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "node --import tsx scripts/seed-demo.ts",
    "db:seed:belief-reversal-demo": "node --import tsx scripts/seed-belief-reversal-demo.ts"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.2",
    "mammoth": "1.12.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "unpdf": "1.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.118.0"
  },
  "type": "module"
}
