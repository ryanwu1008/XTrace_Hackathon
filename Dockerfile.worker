# syntax=docker/dockerfile:1

FROM node:22.13-bookworm-slim AS dependencies

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts \
  && npm cache clean --force

FROM node:22.13-bookworm-slim AS worker

ARG APPLICATION_COMMIT

ENV NODE_ENV=production \
  APPLICATION_COMMIT=${APPLICATION_COMMIT} \
  WORKER_HEALTH_FILE=/tmp/vsee-worker-health \
  WORKER_HEALTH_MAX_AGE_MS=60000

WORKDIR /app
COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node package.json package-lock.json tsconfig.json ./
COPY --chown=node:node db ./db
COPY --chown=node:node lib ./lib
COPY --chown=node:node worker ./worker
COPY --chown=node:node seed/manifest.json ./seed/manifest.json
COPY --chown=node:node seed/belief-reversal ./seed/belief-reversal
COPY --chown=node:node seed/underwriting ./seed/underwriting
COPY --chown=node:node research/framework-authoring ./research/framework-authoring

USER node

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["npm", "run", "worker:health"]

CMD ["npm", "run", "worker"]
