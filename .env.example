# Application
PUBLIC_APP_URL=http://localhost:3000
# public_demo is anonymous, synthetic, and read-only. public_sandbox is
# anonymous and writable only in DEMO_WORKSPACE_ID. Use product only with the
# explicitly trusted OpenAI Sites provider and one server-side membership:
# VSEE_DEPLOYMENT_MODE=product + VSEE_TRUSTED_AUTH_PROVIDER=openai_sites
VSEE_DEPLOYMENT_MODE=public_demo
VSEE_TRUSTED_AUTH_PROVIDER=
DEMO_WORKSPACE_ID=workspace_demo

# XTrace Memory Manager (server and worker only)
XTRACE_API_KEY=
# Optional legacy compatibility only; current mmk_ keys do not use an Org ID.
XTRACE_ORG_ID=
XTRACE_API_BASE_URL=https://api.production.xtrace.ai
# Use a distinct value for each staging/production memory namespace.
XTRACE_APP_ID=replace-with-an-environment-specific-xtrace-app-id

# Anthropic (server and worker only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Public market evidence (server and worker only)
MARKET_USER_AGENT=VSee VC Demo your-contact@example.com
CRUNCHBASE_API_KEY=
MARKET_OFFICIAL_FEEDS_JSON=[]
MARKET_PUBLISHER_FEEDS_JSON=[]

# PostgreSQL REST gateway / Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=vsee-demo-sources
DOCUMENT_URL_SIGNING_SECRET=
